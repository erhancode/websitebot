# ---------------------------------------------------------------------------
# Copy this file to .env and fill in at least AI_API_KEY.
# .env is git-ignored and never committed.
# ---------------------------------------------------------------------------

# --- AI (required) ---------------------------------------------------------
# Any OpenAI-compatible endpoint. Default provider is Groq.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=qwen/qwen3.8-27b
AI_MAX_TOKENS=250
AI_TEMPERATURE=0.5
AI_TIMEOUT=20
AI_SSL_VERIFY=true

# --- Branding (optional) ---------------------------------------------------
BOT_BRAND_NAME=Your Company
BOT_ASSISTANT_NAME=Assistant
BOT_ASSISTANT_ROLE=AI support assistant
BOT_SUBTITLE=AI assistant
BOT_WEBSITE=
BOT_AVATAR=img/bot-avatar.svg
BOT_COLOR_PRIMARY=#004d40
BOT_COLOR_ACCENT=#c6a15b

# --- Widget (optional) -----------------------------------------------------
BOT_DEFAULT_LANG=en
BOT_POSITION=left
BOT_AUTO_OPEN=false
BOT_OPEN_DELAY=25000
BOT_SCROLL_THRESHOLD=0.5
BOT_MAX_HISTORY=6
BOT_MAX_INPUT=1000
BOT_SHOW_LAUNCHER=true
# Set these when the site is not served from the domain root.
BOT_ASSET_BASE=/assets/
BOT_API_BASE=/api/bot
# Only when the widget runs on another origin than the API:
BOT_CORS_ORIGIN=

# --- Leads (optional) ------------------------------------------------------
BOT_STORE_LEADS=true
# Leave empty to disable the lead e-mail. Leads are still stored in data/bot_leads.json.
LEAD_NOTIFY_EMAIL=
BOT_INTERNAL_KEY=
BOT_RATE_LIMIT=20
BOT_RATE_WINDOW=60
# Set to true when the site sits behind Cloudflare or another reverse proxy.
BOT_TRUST_PROXY=false
BOT_LEAD_DEDUPE=600
BOT_KEEP_LEADS=2000

# --- Mail (optional, only for lead e-mails) --------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@example.com
FROM_NAME=Your Company
SMTP_SSL_VERIFY=true

# --- Prompt overrides (optional) ------------------------------------------
# Extra instructions appended to the generated system prompt:
BOT_EXTRA_PROMPT=
# Full replacement of the system prompt (leave empty to use the generated one):
BOT_SYSTEM_PROMPT=
